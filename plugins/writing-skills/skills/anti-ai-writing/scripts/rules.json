{
  "schemaVersion": 2,
  "rules": {
    "common": [
      {
        "id": "common.em-dash",
        "severity": "error",
        "terms": ["—", "―"],
        "message": "Replace the em dash or horizontal bar with a sentence break or punctuation."
      }
    ],
    "ja": [
      {
        "id": "ja.line-ending-colon",
        "severity": "warning",
        "pattern": "(?m)[:：][ \\t]*(?=\\r?$)",
        "message": "日本語ではコロンで行を終えない（例：次の通りです）。"
      },
      {
        "id": "ja.warning-word",
        "severity": "warning",
        "terms": ["正本", "効く", "効いて", "効き", "壊れ", "境界", "実測", "静か", "瞬間", "黙って", "疑う", "事故", "別物", "照合", "断定"],
        "message": "AI が多用しやすい語。文脈に合う一般的な表現へ置き換えられないか確認する。"
      },
      {
        "id": "ja.heading-punctuation",
        "severity": "warning",
        "pattern": "(?m)^ {0,3}#{1,6}[ \\t]+[^\\n]*[、。]",
        "message": "見出しやスライドタイトルに読点・句点を使わない。語句は中黒や「と」で並べ、長いなら要点に絞る。"
      },
      {
        "id": "ja.vague-attribution",
        "severity": "warning",
        "terms": ["と言われています", "と言われている", "専門家によると", "専門家は", "多くの専門家", "研究によると", "調査によると", "一般的に"],
        "message": "出典が曖昧な主張。誰が言っているのかを示すか、根拠がなければ削る。"
      },
      {
        "id": "ja.not-just-template",
        "severity": "warning",
        "pattern": "単なる[^。！？\\n]{1,60}ではなく|(?:だけでなく|のみならず|にとどまらず)[^。！？\\n]{1,60}(?:も|まで)",
        "message": "「単なる〜ではなく」型の対比。違いが情報を足していなければ、主張を直接書く。"
      },
      {
        "id": "ja.generic-conclusion",
        "severity": "warning",
        "terms": ["今後の発展が期待", "今後の展開が期待", "今後の展開に注目", "今後ますます", "ますます重要", "明るい未来"],
        "message": "どの文書にも置ける締め。具体的な予定、事実、次の行動に置き換えるか、削る。"
      },
      {
        "id": "ja.inline-header-list",
        "severity": "info",
        "pattern": "(?m)^[ \\t]*(?:[-*+]|\\d+[.)])[ \\t]+\\*\\*[^*\\n]{1,40}(?:[:：]\\*\\*|\\*\\*[:：])",
        "message": "太字ラベルとコロンで始まる箇条書き。ラベルが本文の繰り返しなら散文にする。新しい情報を足すなら残してよい。"
      },
      {
        "id": "ja.light-verb",
        "severity": "info",
        "terms": ["を行う", "を行い", "を行った", "を行って", "を行います", "を行いました", "を実施"],
        "message": "「〜を行う」「〜を実施する」。「検証を行う」を「検証する」にするなど、具体的な動詞にできないか確認する。"
      },
      {
        "id": "ja.arrow-shorthand",
        "severity": "info",
        "terms": ["→", "⇒"],
        "message": "矢印で文を省略している。述語のある文にするか、「AからBへ」と書く。"
      }
    ],
    "en": [
      {
        "id": "en.boilerplate",
        "severity": "warning",
        "pattern": "\\b(?:in today['’]s (?:fast-paced|ever-changing|digital) world|it(?: is|['’]s) (?:(?:important|worthwhile) to note|worth noting)|in conclusion)\\b",
        "message": "Consider removing the announcement and stating the point directly."
      },
      {
        "id": "en.cliche",
        "severity": "warning",
        "pattern": "\\b(?:delv(?:e|es|ed|ing) into|unlock(?:s|ed|ing)? the (?:potential|power) of|game[- ]changer)\\b",
        "message": "Replace the stock phrase with a concrete action or result."
      },
      {
        "id": "en.inflated",
        "severity": "warning",
        "pattern": "\\b(?:seamlessly|groundbreaking|revolutionary|leverage|utilize)\\b",
        "message": "Check the evidence or choose a precise everyday word."
      },
      {
        "id": "en.not-only",
        "severity": "warning",
        "pattern": "\\bnot (?:just|only)\\b[^.!?\\n]{1,100}\\bbut also\\b",
        "message": "Check whether this contrast adds information rather than a familiar template."
      }
    ]
  }
}
